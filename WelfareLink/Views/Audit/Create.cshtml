@model WelfareLink.Models.Audit
@{
    ViewData["Title"] = "Raise Audit Finding";
    var programId = ViewBag.ProgramId as int?;
}

<div class="page-header">
    <h1><i class="bi bi-clipboard-check"></i> Raise Audit Finding</h1>
    <a asp-action="Index" class="btn btn-modern btn-secondary-modern">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="content-card" style="max-width:700px;margin:0 auto;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-floating-modern mb-3">
            <label class="form-label-modern">Program ID <small class="text-muted">(optional)</small></label>
            <input asp-for="ProgramID" type="number" class="form-control"
                   value="@(programId.HasValue ? programId.ToString() : "")"
                   placeholder="Leave blank for general finding" />
        </div>

        <div class="form-floating-modern mb-3">
            <label asp-for="FindingType" class="form-label-modern">Finding Type</label>
            <select asp-for="FindingType" class="form-select" required>
                <option value="">-- Select --</option>
                <option>Overspend</option>
                <option>AmountMismatch</option>
                <option>DocumentMissing</option>
                <option>Irregularity</option>
                <option>Clean</option>
                <option>Other</option>
            </select>
            <span asp-validation-for="FindingType" class="text-danger"></span>
        </div>

        <div class="form-floating-modern mb-4">
            <label asp-for="Description" class="form-label-modern">Description / Findings</label>
            <textarea asp-for="Description" class="form-control" rows="5"
                      placeholder="Describe the audit finding in detail..." required></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="action-buttons">
            <a asp-action="Index" class="btn btn-modern btn-secondary-modern">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
            <button type="submit" class="btn btn-modern btn-primary-modern">
                <i class="bi bi-check-circle"></i> Submit Finding
            </button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
