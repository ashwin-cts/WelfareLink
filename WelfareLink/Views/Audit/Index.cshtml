@model IEnumerable<WelfareLink.Services.Audit>
@{
    ViewData["Title"] = "Audit Findings";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-list-check"></i> All Audit Findings</h1>
        <p class="mb-0 text-muted">Formal audit records across all programs</p>
    </div>
    <div class="action-buttons">
        <a asp-action="Dashboard" class="btn btn-modern btn-secondary-modern">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-action="Create" class="btn btn-modern btn-primary-modern">
            <i class="bi bi-plus-circle"></i> New Finding
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="content-card">
    @if (!Model.Any())
    {
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle"></i> No audit findings recorded yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Program</th>
                        <th>Finding Type</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Audited By</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">#@a.AuditID</span></td>
                            <td>
                                @if (a.ProgramID.HasValue)
                                {
                                    <strong>@(a.ProgramTitle ?? $"Program #{a.ProgramID}")</strong>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><span class="badge bg-warning text-dark">@a.FindingType</span></td>
                            <td>@(a.Description.Length > 60 ? a.Description[..60] + "…" : a.Description)</td>
                            <td>
                                @if (a.Status == "Open")
                                {
                                    <span class="status-badge status-pending">Open</span>
                                }
                                else if (a.Status == "Under Investigation")
                                {
                                    <span class="status-badge status-processing">Under Investigation</span>
                                }
                                else if (a.Status == "Resolved")
                                {
                                    <span class="status-badge status-fully-disbursed">Resolved</span>
                                }
                                else
                                {
                                    <span class="status-badge status-failed">@a.Status</span>
                                }
                            </td>
                            <td>@(a.AuditedByUserName ?? $"User #{a.AuditedByUserId}")</td>
                            <td><small>@a.AuditDate.ToString("dd MMM yyyy")</small></td>
                            <td>
                                @if (a.Status == "Open")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@a.AuditID" />
                                        <input type="hidden" name="status" value="Under Investigation" />
                                        <button type="submit" class="btn btn-sm btn-modern btn-warning-modern" title="Investigate">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </form>
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@a.AuditID" />
                                        <input type="hidden" name="status" value="Resolved" />
                                        <button type="submit" class="btn btn-sm btn-modern btn-success-modern" title="Mark Resolved">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                }
                                else if (a.Status == "Under Investigation")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@a.AuditID" />
                                        <input type="hidden" name="status" value="Resolved" />
                                        <button type="submit" class="btn btn-sm btn-modern btn-success-modern" title="Mark Resolved">
                                            <i class="bi bi-check-lg"></i> Resolve
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
