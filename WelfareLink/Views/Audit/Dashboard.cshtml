@model IEnumerable<WelfareLink.Services.ProgramAuditSummary>
@{
    ViewData["Title"] = "Government Auditor Dashboard";
    var totalBudget = Model.Sum(p => (double)p.Budget);
    var totalDisbursed = Model.Sum(p => p.TotalDisbursed);
    var totalBeneficiaries = Model.Sum(p => p.TotalBeneficiaries);
    var openAudits = Model.Sum(p => p.OpenAudits);
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-bank"></i> Government Auditor Dashboard</h1>
        <p class="mb-0 text-muted">Financial overview across all welfare programs</p>
    </div>
    <div class="action-buttons">
        <a asp-action="Index" class="btn btn-modern btn-secondary-modern">
            <i class="bi bi-list-check"></i> All Audit Findings
        </a>
        <a asp-action="Create" class="btn btn-modern btn-primary-modern">
            <i class="bi bi-plus-circle"></i> New Audit Finding
        </a>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="content-card text-center">
            <i class="bi bi-currency-rupee" style="font-size:2.5rem;color:#1e3c72;"></i>
            <h3 class="mt-2 mb-0">@totalBudget.ToString("N0")</h3>
            <small class="text-muted">Total Budget (All Programs)</small>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="content-card text-center">
            <i class="bi bi-cash-stack" style="font-size:2.5rem;color:#10b981;"></i>
            <h3 class="mt-2 mb-0">@totalDisbursed.ToString("N0")</h3>
            <small class="text-muted">Total Disbursed</small>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="content-card text-center">
            <i class="bi bi-people-fill" style="font-size:2.5rem;color:#00b4d8;"></i>
            <h3 class="mt-2 mb-0">@totalBeneficiaries</h3>
            <small class="text-muted">Total Beneficiaries</small>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="content-card text-center">
            <i class="bi bi-clipboard-check" style="font-size:2.5rem;color:#f59e0b;"></i>
            <h3 class="mt-2 mb-0">@openAudits</h3>
            <small class="text-muted">Open Audit Findings</small>
        </div>
    </div>
</div>

<!-- Per-Program Table -->
<div class="content-card">
    <h4 class="mb-3"><i class="bi bi-table"></i> Program Financial Summary</h4>

    @if (!Model.Any())
    {
        <div class="alert alert-info mb-0"><i class="bi bi-info-circle"></i> No programs found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th>Program</th>
                        <th>Status</th>
                        <th>Budget</th>
                        <th>Resources</th>
                        <th>Beneficiaries</th>
                        <th>Total Benefit</th>
                        <th>Total Disbursed</th>
                        <th>Remaining</th>
                        <th>Open Audits</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.OrderBy(x => x.Title))
                    {
                        var utilisation = p.Budget > 0 ? (p.TotalDisbursed / (double)p.Budget * 100) : 0;
                        var barColour = utilisation >= 90 ? "bg-danger" : utilisation >= 70 ? "bg-warning" : "bg-success";
                        <tr>
                            <td>
                                <strong>@p.Title</strong><br />
                                <small class="text-muted">ID #@p.ProgramID</small>
                            </td>
                            <td>
                                @if (p.Status == "Active")
                                {
                                    <span class="status-badge status-fully-disbursed">Active</span>
                                }
                                else if (p.Status == "Suspended")
                                {
                                    <span class="status-badge status-partial">Suspended</span>
                                }
                                else if (p.Status == "Expired")
                                {
                                    <span class="status-badge status-failed">Expired</span>
                                }
                                else
                                {
                                    <span class="status-badge status-processing">@p.Status</span>
                                }
                            </td>
                            <td>@p.Budget.ToString("N2")</td>
                            <td><span class="badge bg-info">@p.TotalResources units</span></td>
                            <td><strong>@p.TotalBeneficiaries</strong></td>
                            <td>@p.TotalBenefitAmount.ToString("N2")</td>
                            <td>
                                <strong>@p.TotalDisbursed.ToString("N2")</strong>
                                <div class="progress mt-1" style="height:5px;">
                                    <div class="progress-bar @barColour" style="width:@Math.Min(utilisation,100).ToString("F0")%"></div>
                                </div>
                                <small class="text-muted">@utilisation.ToString("F1")% of budget</small>
                            </td>
                            <td>
                                @if (p.RemainingBudget < 0)
                                {
                                    <span class="text-danger fw-bold">@p.RemainingBudget.ToString("N2") ⚠️</span>
                                }
                                else
                                {
                                    <span class="text-success">@p.RemainingBudget.ToString("N2")</span>
                                }
                            </td>
                            <td>
                                @if (p.OpenAudits > 0)
                                {
                                    <span class="badge bg-danger">@p.OpenAudits Open</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Clean</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Create" asp-route-programId="@p.ProgramID"
                                   class="btn btn-sm btn-modern btn-primary-modern" title="Raise audit finding">
                                    <i class="bi bi-plus-circle"></i> Raise Finding
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
