@model WelfareLink.Models.ComplainceRecord
@{
    ViewData["Title"] = "Raise Compliance Violation";
    var entityType = ViewBag.EntityType as string;
    var entityId = ViewBag.EntityId as int?;
}

<div class="page-header">
    <h1><i class="bi bi-exclamation-triangle"></i> Raise Compliance Violation</h1>
    <a asp-action="Index" class="btn btn-modern btn-secondary-modern">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="content-card" style="max-width:700px;margin:0 auto;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @if (ViewBag.AlreadyFlagged == true)
        {
            <div class="alert alert-warning">
                This entity already has an open compliance record. <a asp-action="Details" asp-route-id="@ViewBag.ExistingRecordId">View existing record</a>
            </div>
        }

        <div class="row mb-3">
            <div class="col-md-8">
                <label class="form-label-modern">Entity Type</label>
                <select asp-for="EntityType" class="form-select" required>
                    <option value="">-- Select --</option>
                    <option value="Benefit" selected="@(entityType == "Benefit")">Benefit</option>
                    <option value="Application" selected="@(entityType == "Application")">Application</option>
                    <option value="Disbursement" selected="@(entityType == "Disbursement")">Disbursement</option>
                    <option value="CitizenDocument" selected="@(entityType == "CitizenDocument")">Citizen Document</option>
                    <option value="EligibilityCheck" selected="@(entityType == "EligibilityCheck")">Eligibility Check</option>
                </select>
                <span asp-validation-for="EntityType" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label-modern">Entity ID</label>
                <input asp-for="EntityId" type="number" class="form-control"
                       value="@(entityId.HasValue ? entityId.ToString() : "")"
                       placeholder="e.g. 12" required />
                <span asp-validation-for="EntityId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-floating-modern mb-3">
            <label asp-for="ViolationType" class="form-label-modern">Violation Type</label>
            <select asp-for="ViolationType" class="form-select" required>
                <option value="">-- Select --</option>
                <option>AmountExceedsBudget</option>
                <option>AmountMismatch</option>
                <option>DisbursementWrong</option>
                <option>BenefitAllocationWrong</option>
                <option>NoEligibilityCheck</option>
                <option>UnverifiedDocApproved</option>
                <option>DocumentMissing</option>
                <option>DuplicateApplication</option>
                <option>MoreThan2DaysSinceApproval</option>
                <option>Other</option>
            </select>
            <span asp-validation-for="ViolationType" class="text-danger"></span>
        </div>

        <div class="form-floating-modern mb-4">
            <label asp-for="Description" class="form-label-modern">Description</label>
            <textarea asp-for="Description" class="form-control" rows="5"
                      placeholder="Describe the violation in detail..." required></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="action-buttons">
            <a asp-action="Index" class="btn btn-modern btn-secondary-modern">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
            <button type="submit" class="btn btn-modern btn-danger-modern">
                <i class="bi bi-flag-fill"></i> Raise Violation
            </button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
