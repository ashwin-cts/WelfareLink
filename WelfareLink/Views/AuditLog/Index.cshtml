@model IEnumerable<WelfareLink.Services.AuditLog>
@{
    ViewData["Title"] = "Audit Log";
    var userRole = Context.Session.GetString("UserRole");
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-journal-text"></i> System Audit Log</h1>
        <p class="mb-0 text-muted">Complete record of all system actions</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="content-card">
    <div class="mb-3 d-flex gap-2 align-items-center flex-wrap">
        <input type="text" id="searchInput" class="form-control" style="max-width:320px;" placeholder="Search action, entity, description..." />
        <select id="entityFilter" class="form-select" style="max-width:180px;">
            <option value="">All Entities</option>
            <option>Benefit</option>
            <option>Application</option>
            <option>EligibilityCheck</option>
            <option>CitizenDocument</option>
            <option>Disbursement</option>
        </select>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle"></i> No audit log entries yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-modern" id="auditTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>ID</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr data-entity="@log.EntityType">
                            <td><span class="badge bg-secondary">#@log.LogID</span></td>
                            <td>
                                <small>@log.Timestamp.ToString("dd MMM yyyy")</small><br />
                                <small class="text-muted">@log.Timestamp.ToString("HH:mm:ss")</small>
                            </td>
                            <td>
                                @if (log.UserId.HasValue)
                                {
                                    <span><i class="bi bi-person-fill text-primary"></i> @(log.UserName ?? $"User #{log.UserId}")</span>
                                }
                                else
                                {
                                    <span class="text-muted"><i class="bi bi-robot"></i> System</span>
                                }
                            </td>
                            <td><span class="badge bg-primary">@log.Action</span></td>
                            <td><span class="badge bg-secondary">@log.EntityType</span></td>
                            <td><code>#@log.EntityId</code></td>
                            <td>@log.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');
        const entityFilter = document.getElementById('entityFilter');
        const rows = document.querySelectorAll('#auditTable tbody tr');

        function filterRows() {
            const search = searchInput.value.toLowerCase();
            const entity = entityFilter.value.toLowerCase();
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const rowEntity = (row.dataset.entity || '').toLowerCase();
                const matchSearch = !search || text.includes(search);
                const matchEntity = !entity || rowEntity === entity;
                row.style.display = matchSearch && matchEntity ? '' : 'none';
            });
        }
        searchInput.addEventListener('input', filterRows);
        entityFilter.addEventListener('change', filterRows);
    </script>
}
