@{
    ViewData["Title"] = "Monthly Trends";
    var currentYear = ViewBag.Year ?? DateTime.Now.Year;
}

<div class="container">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">@ViewData["Title"]</h1>
            <p class="lead">Application trends for @currentYear</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> <strong>Error:</strong> @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @await Html.PartialAsync("_AnalyticsNav")

            <div class="row mb-3">
                <div class="col-md-12 text-end">
                    <div class="btn-group" role="group">
                <a asp-action="MonthlyTrends" asp-route-year="@(currentYear - 1)" class="btn btn-outline-primary">
                    <i class="bi bi-chevron-left"></i> @(currentYear - 1)
                </a>
                <button class="btn btn-primary" disabled>@currentYear</button>
                <a asp-action="MonthlyTrends" asp-route-year="@(currentYear + 1)" class="btn btn-outline-primary">
                    @(currentYear + 1) <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5>Monthly Application Statistics - @currentYear</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.MonthlyData != null && (ViewBag.MonthlyData is System.Collections.IEnumerable))
                    {
                        var monthlyList = ViewBag.MonthlyData as System.Collections.IEnumerable;
                        int monthCount = 0;

                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Month</th>
                                        <th>Total</th>
                                        <th>Pending</th>
                                        <th>Approved</th>
                                        <th>Rejected</th>
                                        <th>Under Review</th>
                                    </tr>
                                </thead>
                                <tbody>
                        @foreach (var month in monthlyList)
                        {
                            monthCount++;
                            try
                            {
                                // Try dynamic access first
                                dynamic monthDynamic = month;
                                var monthName = monthDynamic.Month ?? "N/A";
                                var total = monthDynamic.Total ?? 0;
                                var pending = monthDynamic.Pending ?? 0;
                                var approved = monthDynamic.Approved ?? 0;
                                var rejected = monthDynamic.Rejected ?? 0;
                                var underReview = monthDynamic.UnderReview ?? 0;

                                <tr>
                                    <td><strong>@monthName</strong></td>
                                    <td><span class="badge bg-primary">@total</span></td>
                                    <td><span class="badge bg-warning text-dark">@pending</span></td>
                                    <td><span class="badge bg-success">@approved</span></td>
                                    <td><span class="badge bg-danger">@rejected</span></td>
                                    <td><span class="badge bg-info">@underReview</span></td>
                                </tr>
                            }
                            catch
                            {
                                // Fallback to reflection if dynamic access fails
                                var monthProp = month.GetType().GetProperty("Month", System.Reflection.BindingFlags.IgnoreCase | System.Reflection.BindingFlags.Public);
                                var totalProp = month.GetType().GetProperty("Total", System.Reflection.BindingFlags.IgnoreCase | System.Reflection.BindingFlags.Public);
                                var pendingProp = month.GetType().GetProperty("Pending", System.Reflection.BindingFlags.IgnoreCase | System.Reflection.BindingFlags.Public);
                                var approvedProp = month.GetType().GetProperty("Approved", System.Reflection.BindingFlags.IgnoreCase | System.Reflection.BindingFlags.Public);
                                var rejectedProp = month.GetType().GetProperty("Rejected", System.Reflection.BindingFlags.IgnoreCase | System.Reflection.BindingFlags.Public);
                                var underReviewProp = month.GetType().GetProperty("UnderReview", System.Reflection.BindingFlags.IgnoreCase | System.Reflection.BindingFlags.Public);

                                var monthName = monthProp?.GetValue(month)?.ToString() ?? "N/A";
                                var total = totalProp?.GetValue(month) ?? 0;
                                var pending = pendingProp?.GetValue(month) ?? 0;
                                var approved = approvedProp?.GetValue(month) ?? 0;
                                var rejected = rejectedProp?.GetValue(month) ?? 0;
                                var underReview = underReviewProp?.GetValue(month) ?? 0;

                                <tr>
                                    <td><strong>@monthName</strong></td>
                                    <td><span class="badge bg-primary">@total</span></td>
                                    <td><span class="badge bg-warning text-dark">@pending</span></td>
                                    <td><span class="badge bg-success">@approved</span></td>
                                    <td><span class="badge bg-danger">@rejected</span></td>
                                    <td><span class="badge bg-info">@underReview</span></td>
                                </tr>
                            }
                        }

                        @if (monthCount == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">No data available for @currentYear</td>
                            </tr>
                        }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> No data available for @currentYear
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}
