@model WelfareLink.ViewModels.DocumentStatusViewModel
@{
    ViewData["Title"] = "My Documents";
}

<div class="page-header">
    <h1><i class="bi bi-file-earmark-text"></i> My Documents</h1>
    <p class="mb-0">Manage and track all your uploaded documents</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="CitizenDocument" asp-action="DocumentStatus"
               class="btn-modern @(string.IsNullOrEmpty(Model.FilterStatus) ? "btn-primary-modern" : "btn-secondary-modern") btn-sm">
                <i class="bi bi-list-ul"></i> All
            </a>
            <a asp-controller="CitizenDocument" asp-action="DocumentStatus" asp-route-status="Pending"
               class="btn-modern @(Model.FilterStatus == "Pending" ? "btn-warning-modern" : "btn-secondary-modern") btn-sm">
                <i class="bi bi-clock"></i> Pending
            </a>
            <a asp-controller="CitizenDocument" asp-action="DocumentStatus" asp-route-status="Approved"
               class="btn-modern @(Model.FilterStatus == "Approved" ? "btn-success-modern" : "btn-secondary-modern") btn-sm">
                <i class="bi bi-check-circle"></i> Approved
            </a>
            <a asp-controller="CitizenDocument" asp-action="DocumentStatus" asp-route-status="Rejected"
               class="btn-modern @(Model.FilterStatus == "Rejected" ? "btn-danger-modern" : "btn-secondary-modern") btn-sm">
                <i class="bi bi-x-circle"></i> Rejected
            </a>
        </div>
        <a asp-controller="CitizenDocument" asp-action="UploadDocument" class="btn-modern btn-success-modern btn-sm">
            <i class="bi bi-cloud-upload"></i> Upload New Document
        </a>
    </div>

    @if (Model.Documents.Any())
    {
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th><i class="bi bi-hash"></i> ID</th>
                        <th><i class="bi bi-file-text"></i> Document Name</th>
                        <th><i class="bi bi-tag"></i> Type</th>
                        <th><i class="bi bi-calendar"></i> Uploaded</th>
                        <th><i class="bi bi-shield-check"></i> Status</th>
                        <th><i class="bi bi-gear"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model.Documents)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">#@doc.DocumentID</span></td>
                            <td><strong>@(doc.DocumentName ?? "-")</strong></td>
                            <td>
                                <span class="badge bg-info text-dark">@doc.DocType</span>
                            </td>
                            <td><small>@doc.UploadedDate.ToString("dd MMM yyyy, HH:mm")</small></td>
                            <td>
                                @if (doc.VerificationStatus == "Approved")
                                {
                                    <span class="status-badge status-fully-disbursed">
                                        <i class="bi bi-check-circle-fill"></i> Approved
                                    </span>
                                }
                                else if (doc.VerificationStatus == "Pending")
                                {
                                    <span class="status-badge status-pending">
                                        <i class="bi bi-clock-fill"></i> Pending
                                    </span>
                                }
                                else if (doc.VerificationStatus == "Rejected")
                                {
                                    <span class="status-badge status-failed">
                                        <i class="bi bi-x-circle-fill"></i> Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-processing">@doc.VerificationStatus</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons">
                                    @if (!string.IsNullOrEmpty(doc.FileURI))
                                    {
                                        <a asp-controller="CitizenDocument" asp-action="ViewDocument" asp-route-id="@doc.DocumentID"
                                           target="_blank" class="btn-modern btn-info-modern btn-sm" title="View Document">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    }
                                    @if (doc.VerificationStatus == "Rejected")
                                    {
                                        <a asp-controller="CitizenDocument" asp-action="Reupload" asp-route-id="@doc.DocumentID"
                                           class="btn-modern btn-warning-modern btn-sm" title="Re-upload Document">
                                            <i class="bi bi-arrow-repeat"></i> Re-upload
                                        </a>
                                    }
                                    @if (doc.VerificationStatus == "Pending" || doc.VerificationStatus == "Rejected")
                                    {
                                        <form asp-controller="CitizenDocument" asp-action="Delete" asp-route-documentId="@doc.DocumentID"
                                              method="post" style="display:inline;"
                                              onsubmit="return confirm('Are you sure you want to delete this document?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-modern btn-danger-modern btn-sm" title="Delete Document">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-file-earmark-x" style="font-size: 3rem; color: #cbd5e1;"></i>
            <h5 class="mt-3 text-muted">No documents found</h5>
            <a asp-controller="CitizenDocument" asp-action="UploadDocument" class="btn-modern btn-success-modern mt-2">
                <i class="bi bi-cloud-upload"></i> Upload Your First Document
            </a>
        </div>
    }
</div>

<div class="mt-3">
    <a asp-controller="Citizen" asp-action="Dashboard" class="btn-modern btn-secondary-modern btn-sm">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
</div>
