@model WelfareLink.Models.ComplainceRecordDetailsViewModel
@{
    ViewData["Title"] = $"Compliance Record #{Model.ComplianceRecord.RecordID}";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-shield-exclamation"></i> Compliance Record #@Model.ComplianceRecord.RecordID</h1>
        <p class="mb-0 text-muted">@Model.ComplianceRecord.ViolationType</p>
    </div>
    <a asp-action="Index" class="btn btn-modern btn-secondary-modern">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="content-card mb-3">
            <h4 class="mb-3"><i class="bi bi-info-circle"></i> Record Details</h4>
            <div class="detail-grid">
                <div class="detail-item">
                    <label>Entity Type</label>
                    <p><span class="badge bg-dark fs-6">@Model.ComplianceRecord.EntityType</span></p>
                </div>
                <div class="detail-item">
                    <label>Entity ID</label>
                    <p><code>#@Model.ComplianceRecord.EntityId</code></p>
                </div>
                <div class="detail-item">
                    <label>Violation Type</label>
                    <p><span class="badge bg-danger fs-6">@Model.ComplianceRecord.ViolationType</span></p>
                </div>
                <div class="detail-item">
                    <label>Status</label>
                    <p>
                        @if (Model.ComplianceRecord.Status == "Open")
                        {
                            <span class="status-badge status-pending">Open</span>
                        }
                        else if (Model.ComplianceRecord.Status == "Under Investigation")
                        {
                            <span class="status-badge status-processing">Under Investigation</span>
                        }
                        else if (Model.ComplianceRecord.Status == "Resolved")
                        {
                            <span class="status-badge status-fully-disbursed">Resolved</span>
                        }
                        else
                        {
                            <span class="status-badge status-failed">@Model.ComplianceRecord.Status</span>
                        }
                    </p>
                </div>
                <div class="detail-item">
                    <label>Raised By (Officer)</label>
                    <p>@(Model.ComplianceRecord.RaisedByUserName ?? (Model.ComplianceRecord.RaisedByUserId.HasValue ? $"User #{Model.ComplianceRecord.RaisedByUserId}" : "System"))</p>
                </div>
                <div class="detail-item">
                    <label>Date Raised</label>
                    <p>@Model.ComplianceRecord.CreatedDate.ToString("dd MMMM yyyy HH:mm")</p>
                </div>
                @if (Model.ComplianceRecord.ResolvedDate.HasValue)
                {
                    <div class="detail-item">
                        <label>Date Resolved</label>
                        <p>@Model.ComplianceRecord.ResolvedDate.Value.ToString("dd MMMM yyyy HH:mm")</p>
                    </div>
                    <div class="detail-item">
                        <label>Resolved By</label>
                        <p>@(Model.ComplianceRecord.ResolvedByUserName ?? (Model.ComplianceRecord.ResolvedByUserId.HasValue ? $"User #{Model.ComplianceRecord.ResolvedByUserId}" : "—"))</p>
                    </div>
                }
                <div class="detail-item" style="grid-column:span 2;">
                    <label>Description</label>
                    <p>@Model.ComplianceRecord.Description</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.ComplianceRecord.Notes))
                {
                    <div class="detail-item" style="grid-column:span 2;">
                        <label>Resolution Notes</label>
                        <p>@Model.ComplianceRecord.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        @if (Model.ComplianceRecord.Status != "Resolved" && Model.ComplianceRecord.Status != "Dismissed")
        {
            <div class="content-card">
                <h5 class="mb-3"><i class="bi bi-gear"></i> Update Status</h5>

                @if (Model.ComplianceRecord.Status == "Open")
                {
                    <form asp-action="UpdateStatus" method="post" class="mb-3">
                        <input type="hidden" name="id" value="@Model.ComplianceRecord.RecordID" />
                        <input type="hidden" name="status" value="Under Investigation" />
                        <button type="submit" class="btn btn-modern btn-warning-modern w-100">
                            <i class="bi bi-search"></i> Mark Under Investigation
                        </button>
                    </form>
                }

                <form asp-action="UpdateStatus" method="post" class="mb-2">
                    <input type="hidden" name="id" value="@Model.ComplianceRecord.RecordID" />
                    <input type="hidden" name="status" value="Resolved" />
                    <div class="form-floating-modern mb-2">
                        <label class="form-label-modern">Resolution Notes</label>
                        <textarea name="notes" class="form-control" rows="3" placeholder="Describe what action was taken..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-modern btn-success-modern w-100">
                        <i class="bi bi-check-circle"></i> Mark Resolved
                    </button>
                </form>

                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="id" value="@Model.ComplianceRecord.RecordID" />
                    <input type="hidden" name="status" value="Dismissed" />
                    <button type="submit" class="btn btn-modern btn-secondary-modern w-100">
                        <i class="bi bi-x-circle"></i> Dismiss
                    </button>
                </form>
            </div>
        }
    </div>
</div>

<!-- APPLICATION DETAILS SECTION -->
@if (Model.Application != null)
{
    <div class="row mt-4">
        <div class="col-md-12">
            <h3 class="mb-3"><i class="bi bi-file-earmark-text"></i> Flagged Application Details</h3>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <!-- Application Information -->
            <div class="content-card mb-3">
                <h4 class="mb-3">Application</h4>
                <div class="detail-grid">
                    <div class="detail-item"><label>Application ID</label><p>#@Model.Application.ApplicationID</p></div>
                    <div class="detail-item"><label>Citizen ID</label><p>#@Model.Application.CitizenID</p></div>
                    <div class="detail-item"><label>Citizen Name</label><p>@(Model.Application.Citizen?.Name ?? "-")</p></div>
                    <div class="detail-item"><label>Program Name</label><p>@(Model.Application.Program?.Title ?? "-")</p></div>
                    <div class="detail-item"><label>Submitted Date</label><p>@Model.Application.SubmittedDate.ToString("dd MMM yyyy")</p></div>
                    <div class="detail-item"><label>Status</label><p>@(Model.Application.Status ?? "-")</p></div>
                    <div class="detail-item" style="grid-column:span 2;"><label>Application Documents</label>
                        @if (Model.Application.ApplicationDocuments != null && Model.Application.ApplicationDocuments.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Document Type</th>
                                            <th>Name</th>
                                            <th>Uploaded Date</th>
                                            <th style="width: 80px;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var docLink in Model.Application.ApplicationDocuments)
                                        {
                                            var doc = docLink.CitizenDocument;
                                            @if (doc != null)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="badge bg-info">@(doc.DocType ?? "Document")</span>
                                                    </td>
                                                    <td>@(doc.DocumentName ?? "-")</td>
                                                    <td>@doc.UploadedDate.ToString("dd MMM yyyy")</td>
                                                    <td>
                                                        <a asp-controller="CitizenDocument" asp-action="ViewDocument" asp-route-id="@doc.DocumentID" 
                                                           target="_blank" class="btn btn-sm btn-outline-primary" title="View Document">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else { <span class="text-muted">No documents</span> }
                    </div>
                </div>
            </div>

            <!-- Benefits & Disbursements -->
            <div class="content-card mb-3">
                <h4 class="mb-3">Benefits & Disbursements</h4>
                @if (Model.Application.Benefits != null && Model.Application.Benefits.Count > 0)
                {
                    foreach (var b in Model.Application.Benefits)
                    {
                        <div class="mb-3 p-2 border rounded">
                            <h6>Benefit #@b.BenefitID - @b.Type</h6>
                            <p><strong>Amount:</strong> ₹@b.Amount</p>
                            <p><strong>Status:</strong> @b.Status</p>
                            <p><strong>Date:</strong> @b.Date.ToString("dd MMM yyyy")</p>

                            <h6>Disbursements</h6>
                            @if (b.Disbursements != null && b.Disbursements.Count > 0)
                            {
                                <table class="table table-sm">
                                    <thead><tr><th>ID</th><th>Date</th><th>Amount</th><th>Status</th></tr></thead>
                                    <tbody>
                                        @foreach (var d in b.Disbursements)
                                        {
                                            <tr>
                                                <td>@d.DisbursementID</td>
                                                <td>@d.Date.ToString("dd MMM yyyy")</td>
                                                <td>₹@d.Amount</td>
                                                <td>@d.Status</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else { <p class="text-muted">No disbursements</p> }
                        </div>
                    }
                }
                else { <p class="text-muted">No benefits allocated</p> }
            </div>

            <!-- Resource Allocation -->
            <div class="content-card mb-3">
                <h4 class="mb-3">Resource Allocation</h4>
                @{
                    var pr = Model.ProgramResources;
                }
                @if (pr != null)
                {
                    <p><strong>Program:</strong> @pr.ProgramTitle</p>
                    <p><strong>Program Budget:</strong> ₹@pr.ProgramBudget</p>
                    <p><strong>Total Allocated:</strong> ₹@pr.TotalAllocated</p>
                    <p><strong>Remaining:</strong> ₹@pr.RemainingBudget</p>

                    @if (pr.Resources != null && pr.Resources.Count > 0)
                    {
                        <table class="table table-sm">
                            <thead><tr><th>Resource ID</th><th>Name</th><th>Allocated</th></tr></thead>
                            <tbody>
                                @foreach (var r in pr.Resources)
                                {
                                    <tr>
                                        <td>@r.ResourceID</td>
                                        <td>@r.Name</td>
                                        <td>₹@r.AmountAllocated</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else { <p class="text-muted">No resources allocated</p> }
                }
                else { <p class="text-muted">No resource information available</p> }
            </div>
        </div>
    </div>
}
