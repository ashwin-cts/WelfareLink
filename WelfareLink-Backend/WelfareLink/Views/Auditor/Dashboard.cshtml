@{
    ViewData["Title"] = "Auditor Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="mb-3">Government Auditor Dashboard</h1>
            <hr />
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert">
            <strong>Error:</strong> @ViewBag.Error
        </div>
    }

    <!-- Navigation Tabs -->
    <div class="row mb-4">
        <div class="col-md-12">
            <ul class="nav nav-tabs" id="auditorTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" href="@Url.Action("Dashboard", "Auditor")">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("BudgetMonitoring", "Auditor")">Budget Monitoring</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("ResourceStatement", "Auditor")">Resource Statement</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("DisbursementStatement", "Auditor")">Disbursement Statement</a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Dashboard Cards -->
    <div class="row">
        <!-- Total Applications Card -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-primary font-weight-bold text-uppercase mb-1">Total Applications</div>
                    <div class="h3 mb-0">
                        @if (Model != null && Model.TotalApplications != null)
                        {
                            <span>@Model.TotalApplications</span>
                        }
                        else
                        {
                            <span>0</span>
                        }
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <small class="text-muted">Count of all applications</small>
                </div>
            </div>
        </div>

        <!-- Total Programs Card -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-success font-weight-bold text-uppercase mb-1">Total Programs</div>
                    <div class="h3 mb-0">
                        @if (Model != null && Model.TotalPrograms != null)
                        {
                            <span>@Model.TotalPrograms</span>
                        }
                        else
                        {
                            <span>0</span>
                        }
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <small class="text-muted">Count of all programs</small>
                </div>
            </div>
        </div>

        <!-- Total Budget Card -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-warning font-weight-bold text-uppercase mb-1">Total Budget</div>
                    <div class="h3 mb-0">
                        @if (Model != null && Model.TotalBudget != null)
                        {
                            <span>₹ @string.Format("{0:N2}", Model.TotalBudget)</span>
                        }
                        else
                        {
                            <span>₹ 0</span>
                        }
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <small class="text-muted">Sum of all program budgets</small>
                </div>
            </div>
        </div>

        <!-- Total Resource Card -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-info font-weight-bold text-uppercase mb-1">Total Resource</div>
                    <div class="h3 mb-0">
                        @if (Model != null && Model.TotalResource != null)
                        {
                            <span>₹ @string.Format("{0:N2}", Model.TotalResource)</span>
                        }
                        else
                        {
                            <span>₹ 0</span>
                        }
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <small class="text-muted">Total quantity (amount INR) in resources</small>
                </div>
            </div>
        </div>

        <!-- Total Disbursement Card -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-danger font-weight-bold text-uppercase mb-1">Total Disbursement</div>
                    <div class="h3 mb-0">
                        @if (Model != null && Model.TotalDisbursement != null)
                        {
                            <span>₹ @string.Format("{0:N2}", Model.TotalDisbursement)</span>
                        }
                        else
                        {
                            <span>₹ 0</span>
                        }
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <small class="text-muted">Sum of all disbursements</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <a href="@Url.Action("BudgetMonitoring", "Auditor")" class="btn btn-primary">
                        <i class="fas fa-chart-pie"></i> View Budget Breakdown
                    </a>
                    <a href="@Url.Action("ResourceStatement", "Auditor")" class="btn btn-info">
                        <i class="fas fa-list"></i> Resource Allocation History
                    </a>
                    <a href="@Url.Action("DisbursementStatement", "Auditor")" class="btn btn-success">
                        <i class="fas fa-money-bill"></i> Disbursement History
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
